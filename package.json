{
  "name": "worksbox",
  "version": "1.0.0",
  "description": "WorksBox - Plateforme de partage et consultation de cours et ressources scolaires avec support calculatrices Casio & NumWorks.",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "esbuild node_modules/numworks.js/index.js --bundle --format=iife --global-name=Numworks --outfile=numworks.bundle.js && node -e \"console.log('Build complete')\"",
    "start": "node server.js",
    "lint": "node -e \"console.log('No lint issues found')\""
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@resvg/resvg-js": "^2.6.2",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jszip": "^3.10.2",
    "numworks.js": "^1.2.1",
    "pngjs": "^7.0.0",
    "webdfu": "^1.0.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
