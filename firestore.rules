rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (request.auth.token.email == "romanferriere4@gmail.com" ||
         request.auth.token.email == "roman.ferriere4@gmail.com" ||
         request.auth.token.email.matches('(?i)^r[o.]*m[a.]*n[.]*f[e.]*r[r.]*i[e.]*r[e.]*4@gmail\\.com$'));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles & personal favorites
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Courses collection - Public read, write restricted to verified admin
    match /artifacts/{appId}/public/data/courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Articles & announcements - Public read, write restricted to verified admin
    match /artifacts/{appId}/public/data/articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global platform settings - Public read, write restricted to verified admin
    match /artifacts/{appId}/public/data/settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
