rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             (!('selectedSchool' in data) || (data.selectedSchool is string && data.selectedSchool.size() <= 128)) &&
             (!('selectedClass' in data) || (data.selectedClass is string && data.selectedClass.size() <= 128)) &&
             (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 200));
    }

    // User profile and personal preferences/favorites
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow delete: if isOwner(userId);
    }

    // Courses collection - public read, view counter increments allowed for logged-in or anonymous users
    match /artifacts/{appId}/public/data/courses/{courseId} {
      allow read: if true;
      allow update: if isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['viewsDigital', 'viewsCasio']);
      allow create, delete: if false;
    }

    // Articles collection - public read
    match /artifacts/{appId}/public/data/articles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    // Global settings - public read
    match /artifacts/{appId}/public/data/settings/global {
      allow read: if true;
      allow write: if false;
    }
  }
}
